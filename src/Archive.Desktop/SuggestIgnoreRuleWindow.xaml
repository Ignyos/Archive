<Window x:Class="Archive.Desktop.SuggestIgnoreRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suggest Ignore Rule"
        Icon="Assets/icon.ico"
        Height="560"
        Width="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="20"
                   FontWeight="SemiBold"
                   Text="Choose Ignore Rule" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   x:Name="ContextTextBlock"
                   TextWrapping="Wrap" />

        <DataGrid Grid.Row="2"
                  x:Name="SuggestionsDataGrid"
                  Margin="0,12,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="SuggestionsDataGrid_OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="220" />
                <DataGridTextColumn Header="Strategy" Binding="{Binding Strategy}" Width="170" />
                <DataGridTextColumn Header="Scope" Binding="{Binding ScopeText}" Width="90" />
                <DataGridTextColumn Header="Estimated Matches" Binding="{Binding EstimatedMatchesText}" Width="130" />
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="8"
                BorderThickness="1">
            <TextBlock x:Name="SelectionSummaryTextBlock" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Add Selected Rule"
                    Width="148"
                    Margin="0,0,8,0"
                    Click="AddButton_OnClick" />
            <Button Content="Cancel"
                    Width="88"
                    Click="CancelButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
