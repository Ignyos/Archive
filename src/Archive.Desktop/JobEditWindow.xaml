<Window x:Class="Archive.Desktop.JobEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Job"
        Icon="Assets/icon.ico"
        Height="860"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock"
               Text="Edit Job"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Name" />
            <TextBox Grid.Column="1" x:Name="NameTextBox" MaxLength="200" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Top" Margin="0,4,0,0" Text="Description" />
            <TextBox Grid.Column="1"
                     x:Name="DescriptionTextBox"
                     Height="72"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Job Type" />
            <ComboBox Grid.Column="1"
                      x:Name="JobTypeComboBox"
                      SelectionChanged="JobTypeComboBox_OnSelectionChanged" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SourceLabelTextBlock" VerticalAlignment="Center" Text="Source" />
            <TextBox Grid.Column="1" x:Name="SourcePathTextBox" Margin="0,0,8,0" />
            <Button x:Name="BrowseSourceFolderButton"
                    Grid.Column="2"
                    Content="Folder..."
                    Click="BrowseSourceFolderButton_OnClick" />
        </Grid>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="DestinationLabelTextBlock" VerticalAlignment="Center" Text="Destination" />
            <TextBox Grid.Column="1" x:Name="DestinationPathTextBox" Margin="0,0,8,0" />
            <Button x:Name="BrowseDestinationFolderButton"
                    Grid.Column="2"
                    Content="Folder..."
                    Click="BrowseDestinationFolderButton_OnClick" />
        </Grid>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="OptionsLabelTextBlock" VerticalAlignment="Top" Margin="0,4,0,0" Text="Sync Options" />

            <StackPanel x:Name="SyncOptionsPanel" Grid.Column="1">
                <CheckBox x:Name="RecursiveCheckBox" Content="Include subdirectories" />
                <CheckBox x:Name="DeleteOrphanedCheckBox"
                          Margin="0,6,0,0"
                          Content="Delete orphaned destination files"
                          Checked="DeleteOrphanedCheckBox_OnChecked" />
                <CheckBox x:Name="SkipHiddenAndSystemCheckBox"
                          Margin="0,6,0,0"
                          Content="Skip hidden and system files" />
                <CheckBox x:Name="VerifyAfterCopyCheckBox"
                          Margin="0,6,0,0"
                          Content="Verify copied files with hash check" />
            </StackPanel>

            <StackPanel x:Name="AzureSqlOptionsPanel" Grid.Column="1" Visibility="Collapsed">
                <TextBlock Text="Source Profile (Azure SQL)" />
                <ComboBox x:Name="SourceCredentialProfileComboBox"
                          Margin="0,4,0,0"
                          DisplayMemberPath="Name" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewSourceCredentialNameTextBox"
                             Margin="0,0,8,0"
                             ToolTip="New source profile name" />
                    <PasswordBox x:Name="NewSourceCredentialSecretPasswordBox"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 ToolTip="Connection string or JSON payload" />
                    <Button Grid.Column="2"
                            Width="96"
                            Content="Add Source"
                            Click="AddSourceCredentialProfileButton_OnClick" />
                </Grid>

                <TextBlock Margin="0,12,0,0" Text="Destination Type" />
                <ComboBox x:Name="AzureDestinationTypeComboBox"
                          Margin="0,4,0,0"
                          SelectionChanged="AzureDestinationTypeComboBox_OnSelectionChanged" />

                <TextBlock Margin="0,12,0,0" Text="Destination Target" />
                <TextBox x:Name="AzureDestinationTargetTextBox"
                         Margin="0,4,0,0"
                         ToolTip="Local folder path, blob container[/prefix], or Google Drive folder id" />

                <TextBlock x:Name="DestinationProfileLabelTextBlock"
                           Margin="0,12,0,0"
                           Text="Destination Profile" />
                <ComboBox x:Name="DestinationCredentialProfileComboBox"
                          Margin="0,4,0,0"
                          DisplayMemberPath="Name" />

                <Grid x:Name="NewDestinationCredentialGrid" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewDestinationCredentialNameTextBox"
                             Margin="0,0,8,0"
                             ToolTip="New destination profile name" />
                    <PasswordBox x:Name="NewDestinationCredentialSecretPasswordBox"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 ToolTip="Connection string or service account JSON" />
                    <Button Grid.Column="2"
                            Width="122"
                            Content="Add Destination"
                            Click="AddDestinationCredentialProfileButton_OnClick" />
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="7" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Trigger" />
            <ComboBox Grid.Column="1" x:Name="TriggerTypeComboBox" SelectionChanged="ScheduleInput_OnChanged" />
        </Grid>

        <Grid Grid.Row="8" Margin="0,12,0,0" x:Name="SimpleRecurringRowGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Top" Margin="0,4,0,0" Text="Recurring" />
            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Frequency" />
                    <ComboBox x:Name="SimpleFrequencyComboBox"
                              Width="110"
                              Margin="8,0,0,0"
                              SelectionChanged="ScheduleInput_OnChanged" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Text="Time" />
                    <ComboBox x:Name="SimpleTimeTextBox"
                              Width="84"
                              Margin="8,0,0,0"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              ToolTip="HH:mm"
                              SelectionChanged="ScheduleInput_OnChanged"
                              DropDownClosed="ScheduleInput_OnDropDownClosed"
                              LostFocus="ScheduleInput_OnChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock VerticalAlignment="Center" Text="Weekday" />
                    <ComboBox x:Name="SimpleDayOfWeekComboBox"
                              Width="110"
                              Margin="8,0,0,0"
                              SelectionChanged="ScheduleInput_OnChanged" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Text="Month day" />
                    <TextBox x:Name="SimpleDayOfMonthTextBox"
                             Width="40"
                             Margin="8,0,0,0"
                             TextChanged="ScheduleInput_OnChanged" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="9" Margin="0,12,0,0" x:Name="CronRowGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Cron" />
            <TextBox Grid.Column="1" x:Name="CronExpressionTextBox" TextChanged="ScheduleInput_OnChanged" />
        </Grid>

        <Grid Grid.Row="10" Margin="0,12,0,0" x:Name="OneTimeRowGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Top" Margin="0,4,0,0" Text="One-Time" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <DatePicker x:Name="OneTimeDatePicker" Width="150" SelectedDateChanged="ScheduleInput_OnChanged" />
                <ComboBox x:Name="OneTimeTimeTextBox"
                          Width="84"
                          Margin="8,0,0,0"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          ToolTip="HH:mm"
                          SelectionChanged="ScheduleInput_OnChanged"
                          DropDownClosed="ScheduleInput_OnDropDownClosed"
                          LostFocus="ScheduleInput_OnChanged" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="11" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Enabled" />
            <CheckBox Grid.Column="1" x:Name="EnabledCheckBox" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="12"
                Margin="0,12,0,0"
            Padding="8">
            <TextBlock x:Name="SchedulePreviewTextBlock"
                       Text=""
                       TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="13"
                   Margin="0,16,0,0"
                   Foreground="Red"
                   Text=""
                   x:Name="ValidationTextBlock" />

        <StackPanel Grid.Row="14"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Preview Operations"
                x:Name="PreviewOperationsButton"
                Width="140"
                Margin="0,0,8,0"
                Click="PreviewOperationsButton_OnClick" />
            <Button Content="Save"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="SaveButton_OnClick" />
            <Button Content="Close"
                    Width="88"
                    Click="CloseButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>